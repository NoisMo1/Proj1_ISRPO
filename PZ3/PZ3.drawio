<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram name="WFD - Оформление через туроператора" id="op"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="op_t_1" value="Начало" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="310" y="40" width="180" height="60" as="geometry"/></mxCell><mxCell id="op_a_2" value="Клиент обращается в турфирму и сообщает о желании приобрести путевку" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2d0;strokeColor=#3a9b3a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="140" width="300" height="80" as="geometry"/></mxCell><mxCell id="op_a_3" value="Менеджер уточняет пожелания, бюджет и сроки поездки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2d0;strokeColor=#3a9b3a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="260" width="300" height="70" as="geometry"/></mxCell><mxCell id="op_d_4" value="Подходящий тур найден в базе туроператоров?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f6cbb3;strokeColor=#c96a3a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="370" width="340" height="140" as="geometry"/></mxCell><mxCell id="op_a_5" value="Менеджер формирует заявку и направляет её туроператору" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f2d0;strokeColor=#3a9b3a;arcSize=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="550" width="300" height="70" as="geometry"/></mxCell><mxCell id="op_y_6" value="Ожидание подтверждения заявки туроператором" style="shape=delay;whiteSpace=wrap;html=1;fillColor=#e6dcf5;strokeColor=#7a5aa8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="660" width="260" height="70" as="geometry"/></mxCell><mxCell id="op_d